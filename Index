  <!-- Подключение Firebase -->
  <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app.js"></script>
  <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-firestore.js"></script>
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <div class="logo">PMO</div>
      <div>
        <h1>PMO • График договоров и аналитика</h1>
        <p>Панель управления и мониторинг статусов</p>
      </div>
      <div class="topbar-date" id="current-date">Загрузка...</div>
    </div>
  </header>

  <nav class="tabs">
    <button class="tab active" onclick="switchTab('all')">Все договоры <span class="tab-badge">0</span></button>
    <button class="tab" onclick="switchTab('new')">Новые <span class="tab-badge">0</span></button>
    <button class="tab" onclick="switchTab('in-progress')">В работе <span class="tab-badge">0</span></button>
    <button class="tab" onclick="switchTab('done')">Завершены <span class="tab-badge">0</span></button>
  </nav>

  <div class="wrap">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
      <h2 style="margin:0;font-size:18px">Список договоров</h2>
      <button class="btn btn-primary" onclick="loadData()">Обновить данные</button>
    </div>
    <div id="content">
      <div class="loading">Загрузка данных из Firestore...</div>
    </div>
  </div>

  <script>
    // ВСТАВИТЬ ВАШИ КЛЮЧИ НИЖЕ
    const firebaseConfig = {
      apiKey: "AIzaSyDtssxEM6rmWlQaZeOjGzkbpfhgCbfH3OA",
      authDomain: "pmo2-5b72e.firebaseapp.com",
      projectId: "pmo2-5b72e",
      storageBucket: "pmo2-5b72e.firebasestorage.app",
      messagingSenderId: "18463218600",
      appId: "1:18463218600:web:17391f4207315089219b9d"
    };

    const app = firebase.initializeApp(firebaseConfig);
    const db = firebase.firestore(app);

    let allDocs = [];
    const statusCounts = { all: 0, new: 0, in_progress: 0, done: 0 };

    // Установка текущей даты
    const dateEl = document.getElementById('current-date');
    const now = new Date();
    const options = { year: 'numeric', month: 'long', day: 'numeric' };
    dateEl.textContent = now.toLocaleDateString('ru-RU', options);

    function renderTable(docs) {
      if (!docs.length) {
        document.getElementById('content').innerHTML = '<div class="loading">Договоры не найдены</div>';
        return;
      }

      let html = '<table><thead><tr><th>№</th><th>Договор</th><th>Контрагент</th><th>Сумма</th><th>Статус</th><th>Дата</th></tr></thead><tbody>';
      
      docs.forEach((doc, index) => {
        const data = doc.data();
        let statusClass = '';
        let statusText = '';
        
        if (data.status === 'new') { statusClass = 'status-new'; statusText = 'Новый'; }
        else if (data.status === 'in_progress') { statusClass = 'status-in-progress'; statusText = 'В работе'; }
        else if (data.status === 'done') { statusClass = 'status-done'; statusText = 'Завершен'; }

        html += `
          <tr>
            <td>#\${index + 1}</td>
            <td><strong>\${data.contractNumber || '-'}</strong></td>
            <td>\${data.counterparty || '-'}</td>
            <td>\${data.amount ? data.amount.toLocaleString() : '0 ₽'}</td>
            <td><span class="status-dot ${statusClass}"></span> ${statusText}</td>
            <td>\${data.date || '-'}</td>
          </tr>
        `;
      });

      html += '</tbody></table>';
      document.getElementById('content').innerHTML = html;
    }

    function updateTabCounts() {
      document.querySelectorAll('.tab .tab-badge').forEach(el => el.textContent = '0');
      // Обновляем счетчики в кнопках (упрощенно)
      document.querySelector('button[onclick="switchTab(\'all\')"]').querySelector('.tab-badge').textContent = statusCounts.all;
      document.querySelector('button[onclick="switchTab(\'new\')"]').querySelector('.tab-badge').textContent = statusCounts.new;
      document.querySelector('button[onclick="switchTab(\'in-progress\')"]').querySelector('.tab-badge').textContent = statusCounts.in_progress;
      document.querySelector('button[onclick="switchTab(\'done\')"]').querySelector('.tab-badge').textContent = statusCounts.done;
    }

    async function loadData() {
      const contentDiv = document.getElementById('content');
      contentDiv.innerHTML = '<div class="loading">Загрузка данных...</div>';

      try {
        const snapshot = await db.collection('contracts').get();
        allDocs = snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() }));
        
        // Подсчет статусов
        statusCounts.all = allDocs.length;
        statusCounts.new = allDocs.filter(d => d.status === 'new').length;
        statusCounts.in_progress = allDocs.filter(d => d.status === 'in_progress').length;
        statusCounts.done = allDocs.filter(d => d.status === 'done').length;

        updateTabCounts();
        renderTable(allDocs);
      } catch (error) {
        console.error('Ошибка загрузки:', error);
        contentDiv.innerHTML = `<div class="error">Ошибка: \${error.message}</div>`;
      }
    }

    function switchTab(filter) {
      let filtered = allDocs;
      if (filter !== 'all') {
        filtered = allDocs.filter(doc => doc.status === filter);
      }
      renderTable(filtered);
      
      document.querySelectorAll('.tab').forEach(btn => btn.classList.remove('active'));
      event.currentTarget.classList.add('active');
    }

    // Инициализация при загрузке
    loadData();
  </script>
</body>
</html>
